  <material name="cr5a_white"><color rgba="1 1 1 1"/></material>

  <!-- SolidWorks assembly axes: +Y points down and +Z is depth.
       Rotate to Isaac's Z-up frame, center the footprint, and place the
       lowest caster point (838.3 mm) exactly on Z=0. -->
  <link name="world"/>
  <joint name="world_to_xtrainer" type="fixed">
    <origin xyz="0.781 0.505 0.8383" rpy="-1.57079632679 0 3.14159265359"/>
    <parent link="world"/>
    <child link="xtrainer_base"/>
  </joint>

