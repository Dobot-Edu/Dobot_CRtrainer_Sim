    <collision><geometry><mesh filename="../meshes/cr5a/base_link.STL"/></geometry></collision>
  </link>
  <joint name="xtrainer_to_cr5a" type="fixed">
    <origin xyz="0.780999 0.006920982 0.835" rpy="1.57079632679 -3.14159265359 0"/><parent link="xtrainer_base"/><child link="cr5a_base"/>
